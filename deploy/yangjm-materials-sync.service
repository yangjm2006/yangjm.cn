[Unit]
Description=Mirror OI learning materials from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
UMask=0022
ExecStart=/usr/bin/flock -n /var/lib/yangjm-materials/sync.lock /usr/bin/python3 /opt/yangjm-materials/scripts/sync-materials.py
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yangjm-materials

