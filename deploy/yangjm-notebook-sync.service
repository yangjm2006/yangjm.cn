[Unit]
Description=Update yangjm algorithm notebook from GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
UMask=0022
ExecStart=/usr/bin/flock -n /var/lib/yangjm-notebook/sync.lock /usr/bin/python3 /opt/yangjm-notebook/scripts/sync-notebook.py
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yangjm-notebook

